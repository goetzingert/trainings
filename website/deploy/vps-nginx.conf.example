# Beispiel für den Reverse-Proxy auf dem IONOS-VPS (nginx).
# 10.8.0.2 durch die WireGuard-Adresse des Optiplex ersetzen.
# Zertifikate danach mit certbot holen, siehe README.md.

server {
    listen 80;
    server_name amtsklug.de www.amtsklug.de
                kiklug.de www.kiklug.de ki-klug.de www.ki-klug.de
                kiregelwerk.de www.kiregelwerk.de
                ki-in-der-verwaltung.de www.ki-in-der-verwaltung.de;

    location / {
        proxy_pass http://10.8.0.2:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
